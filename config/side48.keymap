#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Conversion definition for using Japanese keyboard with OS settings

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 0
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_MKP";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            //bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };

        scroll_left_right: behavior_sensor_rotate_mouse_wheel_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            //bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <28 29>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <29 30>;
        };

        lang1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <25 24>;
        };

        lang2 {
            bindings = <&kp LANG2>;
            key-positions = <23 24>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp UP     &kp RIGHT  &kp LEFT      &kp DOWN      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS       &mkp MB1       &mkp MB2     &kp MB3
&kp TAB    &kp Q      &kp W         &kp E         &kp R                 &kp T                       &kp Y          &kp U        &kp I         &kp O      &kp P          &kp LEFT_BRACKET
&kp LCTRL  &kp A      &kp S         &kp D         &kp F                 &kp G                       &kp H          &kp J        &kp K         &kp L      &kp MINUS      &kp RIGHT_BRACKET
&kp LSHFT  &kp Z      &kp X         &kp C         &kp V                 &kp B                       &kp N          &kp M        &kp COMMA     &kp DOT    &lt_mkp 3 MB3  &kp RIGHT_SHIFT
&kp ESC    &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 2 SPACE           &lt (4) LG(LS(NUMBER_4))    &kp BACKSPACE  &lt 1 ENTER  &kp NUMBER_1  &kp SLASH  &kp SEMI       &kp GRAVE
            >;

            sensor-bindings = <&scroll_left_right &scroll_up_down>;
        };

        layer_1 {
            bindings = <
&trans            &trans         &trans        &trans        &trans        &trans         &trans            &trans                &trans
&kp GRAVE         &kp LS(GRAVE)  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp AT_SIGN    &kp LS(NUMBER_9)  &kp LS(SINGLE_QUOTE)  &kp LS(NUMBER_0)   &kp SEMI      &kp LS(NUMBER_1)  &trans
&kp LS(NUMBER_6)  &kp EQUAL      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp HASH       &kp LEFT_BRACKET  &kp SINGLE_QUOTE      &kp RIGHT_BRACKET  &kp LS(SEMI)  &kp JP_COLON      &kp JP_UNDERSCORE
&kp LEFT_SHIFT    &kp ASTERISK   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PIPE       &kp SLASH         &kp BACKSLASH         &kp COMMA          &kp PERIOD    &kp PIPE          &trans
&trans            &trans         &kp NUMBER_0  &trans        &trans        &trans         &trans            &kp NUMBER_0          &kp JP_DQUOTE      &trans        &trans            &trans
            >;

            sensor-bindings = <&scroll_left_right &scroll_up_down>;
        };

        layer_2 {
            bindings = <
&trans  &kp F10  &kp F11  &kp F12  &trans           &trans          &trans        &trans             &trans
&trans  &kp F7   &kp F8   &kp F9   &kp DOLLAR       &kp PERCENT     &kp JP_CARET  &kp JP_AMPERSAND   &kp JP_ASTERISK  &kp MINUS        &kp UNDERSCORE   &trans
&trans  &kp F4   &kp F5   &kp F6   &kp C_VOLUME_UP  &kp C_VOL_DN    &kp K_MUTE    &kp DOUBLE_QUOTES  &kp UP_ARROW     &kp JP_PLUS      &kp JP_ASTERISK  &trans
&trans  &kp F1   &kp F2   &kp F3   &mkp MB4         &mkp MB5        &kp LG(A)     &kp LEFT_ARROW     &kp DOWN_ARROW   &kp RIGHT_ARROW  &trans           &trans
&trans  &trans   &trans   &trans   &trans           &trans          &trans        &trans             &trans           &trans           &trans           &trans
            >;

            sensor-bindings = <&scroll_left_right &scroll_up_down>;
        };

        layer_3 {
            bindings = <
&trans          &trans  &trans        &trans        &trans        &trans              &trans  &trans                &trans
&bt BT_CLR      &trans  &kp F2        &kp F3        &kp F4        &kp F5              &kp F6  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp F9     &kp F10  &kp F11
&bt BT_CLR_ALL  &trans  &bt BT_SEL 4  &trans        &trans        &trans              &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT  &trans   &kp F12
&trans          &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans              &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans     &trans   &trans
&trans          &trans  &bt BT_SEL 0  &trans        &trans        &kp LC(UP_ARROW)    &trans  &trans                &trans                 &trans     &trans   &trans
            >;

            sensor-bindings = <&scroll_left_right &scroll_up_down>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &tog 6        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans        &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&scroll_left_right &scroll_up_down>;
        };
    };
};
